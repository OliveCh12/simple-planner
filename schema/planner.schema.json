{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 3
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "scale": {
            "type": "string",
            "enum": [
              "year",
              "month",
              "week",
              "day",
              "hour"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "local",
                  "google",
                  "icloud",
                  "caldav"
                ]
              },
              "access": {
                "type": "string",
                "enum": [
                  "readwrite",
                  "readonly"
                ]
              },
              "account": {
                "type": "string"
              },
              "externalId": {
                "type": "string"
              },
              "lastSyncedAt": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "access"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "lastAccessedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "start",
          "end",
          "createdAt",
          "updatedAt",
          "lastAccessedAt"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "planId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "event",
              "objective"
            ]
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "recurrence": {
            "type": "string",
            "minLength": 1
          },
          "recurrenceExceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in-progress",
              "completed",
              "cancelled",
              "blocked"
            ]
          },
          "energy": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "executor": {
            "type": "string",
            "enum": [
              "human",
              "ai"
            ]
          },
          "agentBrief": {
            "type": "string"
          },
          "assigneeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attendeeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "timezone": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "src": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name",
                "src"
              ],
              "additionalProperties": false
            }
          },
          "externalId": {
            "type": "string",
            "minLength": 1
          },
          "draft": {
            "type": "boolean"
          },
          "completedAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "planId",
          "kind",
          "title",
          "notes",
          "start",
          "status",
          "energy",
          "executor",
          "assigneeIds",
          "attendeeIds",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "color": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ]
        },
        "accent": {
          "default": "green",
          "type": "string",
          "enum": [
            "green",
            "blue",
            "violet",
            "rose",
            "orange",
            "neutral"
          ]
        },
        "font": {
          "default": "ubuntu",
          "type": "string",
          "enum": [
            "ubuntu",
            "inter",
            "dm-sans",
            "outfit",
            "ibm-plex-sans",
            "source-serif-4",
            "literata",
            "fraunces"
          ]
        },
        "defaultView": {
          "type": "string",
          "enum": [
            "timeline",
            "list"
          ]
        },
        "firstDayOfWeek": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        "dateFormat": {
          "type": "string"
        },
        "showWeekNumbers": {
          "type": "boolean"
        },
        "environment": {
          "default": {
            "weather": false,
            "eventWeather": true,
            "daylight": false,
            "units": "celsius",
            "detail": "full"
          },
          "type": "object",
          "properties": {
            "weather": {
              "default": false,
              "type": "boolean"
            },
            "eventWeather": {
              "default": true,
              "type": "boolean"
            },
            "daylight": {
              "default": false,
              "type": "boolean"
            },
            "units": {
              "default": "celsius",
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            },
            "detail": {
              "default": "full",
              "type": "string",
              "enum": [
                "icon",
                "full"
              ]
            },
            "location": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "timezone": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "lat",
                "lon"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "weather",
            "eventWeather",
            "daylight",
            "units",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "theme",
        "accent",
        "font",
        "defaultView",
        "firstDayOfWeek",
        "dateFormat",
        "showWeekNumbers",
        "environment"
      ],
      "additionalProperties": false
    },
    "activePlanId": {
      "type": "string"
    },
    "lastBackup": {
      "type": "string"
    },
    "lastExport": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "plans",
    "items",
    "people",
    "categories",
    "settings"
  ],
  "additionalProperties": false
}
